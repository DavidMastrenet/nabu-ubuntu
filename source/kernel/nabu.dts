 aliases {
  serial0 = "/soc@0/geniqup@ac0000/serial@a90000";
  hsuart0 = "/soc@0/geniqup@cc0000/serial@c8c000";
  wifi0 = "/soc@0/wifi@18800000";
 };
 battery {
  compatible = "simple-battery";
  charge-full-design-microamp-hours = <0x850e80>;
  energy-full-design-microwatt-hours = <0x200b200>;
  voltage-min-design-microvolt = <0x33e140>;
  voltage-max-design-microvolt = "", "D\\";
  phandle = <0xe5>;
 };
 bl-vddpos-regulator {
  compatible = "regulator-fixed";
  regulator-name = "bl_vddpos_5p5";
  regulator-min-microvolt = <0x53ec60>;
  regulator-max-microvolt = <0x53ec60>;
  regulator-enable-ramp-delay = <0xe9>;
  gpio = <0x31 0x72 0x00>;
  enable-active-high;
  regulator-boot-on;
  phandle = <0x2f>;
 };
 bl-vddneg-regulator {
  compatible = "regulator-fixed";
  regulator-name = "bl_vddneg_5p5";
  regulator-min-microvolt = <0x53ec60>;
  regulator-max-microvolt = <0x53ec60>;
  regulator-enable-ramp-delay = <0xe9>;
  gpio = <0x31 0x73 0x00>;
  enable-active-high;
  regulator-boot-on;
  phandle = <0x30>;
 };
 vph-pwr-regulator {
  compatible = "regulator-fixed";
  regulator-name = "vph_pwr";
  regulator-min-microvolt = <0x387520>;
  regulator-max-microvolt = <0x387520>;
  phandle = <0xf2>;
 };
 vreg_s4a_1p8: pm8150-s4 {
  compatible = "regulator-fixed";
  regulator-name = "vreg_s4a_1p8";
  regulator-min-microvolt = <0x1b7740>;
  regulator-max-microvolt = <0x1b7740>;
  regulator-always-on;
  regulator-boot-on;
  vin-supply = <0xf2>;
  phandle = <0x71>;
 };
 gpio-keys {
  compatible = "gpio-keys";
  pinctrl-names = "default";
  pinctrl-0 = <0x120>;
  key-vol-up {
   label = "Volume Up";
   gpios = <0xe0 0x06 0x01>;
   linux,code = <0x73>;
   debounce-interval = <0x0f>;
   linux,can-disable;
   wakeup-source;
  };
  event-hall-sensor {
   label = "Hall Effect Sensor";
   gpios = <0x31 0x09 0x01>;
   linux,input-type = <0x05>;
   linux,code = <0x00>;
   debounce-interval = <0x0f>;
   linux,can-disable;
   wakeup-source;
  };
 };
};
/ { soc@0 {
cci0: cci@ac4a000 {
   compatible = "qcom,sm8150-cci", "qcom,sdm845-cci";
   #address-cells = <1>;
   #size-cells = <0>;
   reg = <0 0x0ac4a000 0 0x1000>;
   interrupts = <0 460 1>;
   power-domains = <&camcc 0>;
   clocks = <&camcc 16>,
     <&camcc 23>,
     <&camcc 91>,
     <&camcc 24>,
     <&camcc 19>,
     <&camcc 20>;
   clock-names = "camnoc_axi",
          "soc_ahb",
          "slow_ahb_src",
          "cpas_ahb",
          "cci",
          "cci_src";
   assigned-clocks = <&camcc 16>,
       <&camcc 19>;
   assigned-clock-rates = <80000000>, <37500000>;
   pinctrl-names = "default", "sleep";
   pinctrl-0 = <&cci0_default &cci1_default>;
   pinctrl-1 = <&cci0_sleep &cci1_sleep>;
   status = "disabled";
   cci0_i2c0: i2c-bus@0 {
    reg = <0>;
    clock-frequency = <1000000>;
    #address-cells = <1>;
    #size-cells = <0>;
   };
   cci0_i2c1: i2c-bus@1 {
    reg = <1>;
    clock-frequency = <1000000>;
    #address-cells = <1>;
    #size-cells = <0>;
   };
  };
camss: camss@acb3000 {
   compatible = "qcom,sm8150-camss";
   reg = <0 0x0acb3000 0 0x1000>,
         <0 0x0acba000 0 0x1000>,
         <0 0x0ac65000 0 0x1000>,
         <0 0x0ac66000 0 0x1000>,
         <0 0x0ac67000 0 0x1000>,
         <0 0x0ac68000 0 0x1000>,
         <0 0x0acaf000 0 0x4000>,
         <0 0x0acb6000 0 0x4000>;
   reg-names = "csid0",
        "csid1",
        "csiphy0",
        "csiphy1",
        "csiphy2",
        "csiphy3",
        "vfe0",
        "vfe1";
   interrupts = <0 464 1>,
         <0 466 1>,
         <0 477 1>,
         <0 478 1>,
         <0 479 1>,
         <0 448 1>,
         <0 465 1>,
         <0 467 1>;
   interrupt-names = "csid0",
       "csid1",
       "csiphy0",
       "csiphy1",
       "csiphy2",
       "csiphy3",
       "vfe0",
       "vfe1";
   power-domains = <&camcc 2>,
     <&camcc 3>,
     <&camcc 0>;
   power-domain-names = "ife0", "ife1", "top";
   clocks = <&camcc 16>,
     <&camcc 24>,
     <&camcc 25>,
     <&camcc 50>,
     <&camcc 51>,
     <&camcc 57>,
     <&camcc 58>,
     <&camcc 34>,
     <&camcc 26>,
     <&camcc 27>,
     <&camcc 35>,
     <&camcc 28>,
     <&camcc 29>,
     <&camcc 36>,
     <&camcc 30>,
     <&camcc 31>,
     <&camcc 37>,
     <&camcc 32>,
     <&camcc 33>,
     <&gcc 8>,
     <&gcc 9>,
     <&camcc 91>,
     <&camcc 23>,
     <&camcc 47>,
     <&camcc 46>,
     <&camcc 49>,
     <&camcc 48>,
     <&camcc 54>,
     <&camcc 53>,
     <&camcc 56>,
     <&camcc 55>;
   clock-names = "camnoc_axi",
          "cpas_ahb",
          "cphy_rx_src",
          "csi0",
          "csi0_src",
          "csi1",
          "csi1_src",
          "csiphy0",
          "csiphy0_timer",
          "csiphy0_timer_src",
          "csiphy1",
          "csiphy1_timer",
          "csiphy1_timer_src",
          "csiphy2",
          "csiphy2_timer",
          "csiphy2_timer_src",
          "csiphy3",
          "csiphy3_timer",
          "csiphy3_timer_src",
          "gcc_camera_ahb",
          "gcc_camera_axi",
          "slow_ahb_src",
          "soc_ahb",
          "vfe0",
          "vfe0_axi",
          "vfe0_cphy_rx",
          "vfe0_src",
          "vfe1",
          "vfe1_axi",
          "vfe1_cphy_rx",
          "vfe1_src";
   interconnects = <&gem_noc 0 0 &config_noc 8 0>,
     <&mmss_noc 1 0 &mc_virt 1 0>,
     <&mmss_noc 3 0 &mc_virt 1 0>,
     <&camnoc_virt 0 0 &camnoc_virt 3 0>;
   interconnect-names = "cam_ahb",
          "cam_hf_0_mnoc",
          "cam_sf_0_mnoc",
          "cam_hf_0_camnoc";
   iommus = <&apps_smmu 0x840 0x620>,
     <&apps_smmu 0x860 0x620>,
     <&apps_smmu 0xa40 0x620>,
     <&apps_smmu 0xa60 0x620>,
     <&apps_smmu 0xc40 0x620>,
     <&apps_smmu 0xc60 0x620>,
     <&apps_smmu 0xe40 0x620>,
     <&apps_smmu 0xe60 0x620>;
   status = "disabled";
   ports {
    #address-cells = <1>;
    #size-cells = <0>;
   };
  };
}; };
&tlmm {
cci0_default: cci0-default-state {
    pins = "gpio17", "gpio18";
    function = "cci_i2c";
    drive-strength = <2>;
    bias-pull-up;
   };
cci0_sleep: cci0-sleep-state {
    pins = "gpio17", "gpio18";
    function = "cci_i2c";
    drive-strength = <2>;
    bias-pull-down;
   };
cci1_default: cci1-default-state {
    pins = "gpio19", "gpio20";
    function = "cci_i2c";
    drive-strength = <2>;
    bias-pull-up;
   };
cci1_sleep: cci1-sleep-state {
    pins = "gpio19", "gpio20";
    function = "cci_i2c";
    drive-strength = <2>;
    bias-pull-down;
   };
};
/ {
    camera_digital: camera-digital-regulator {
        compatible = "regulator-fixed";
        regulator-name = "camera-digital-1p2";
        regulator-min-microvolt = <1200000>;
        regulator-max-microvolt = <1200000>;
        gpio = <&pm8150l_gpios 3 0>;
        enable-active-high;
        startup-delay-us = <135>;
        vin-supply = <&vreg_s4a_1p8>;
    };
    camera_front_analog: camera-front-analog-regulator {
        compatible = "regulator-fixed";
        regulator-name = "camera-front-analog";
        gpio = <&tlmm 31 0>;
        enable-active-high;
        startup-delay-us = <1000>;
        vin-supply = <&vreg_bob>;
    };
};
&tlmm {
    front_mclk: front-mclk-state {
        pins = "gpio14";
        function = "cam_mclk";
        drive-strength = <2>;
        bias-disable;
    };
};
&cci0 { status = "okay"; };
&cci0_i2c1 {
    clock-frequency = <400000>;
    front_camera: camera@10 {
        compatible = "ovti,ov8856";
        reg = <0x10>;
        clocks = <&camcc 85>;
        clock-names = "xvclk";
        clock-frequency = <19200000>;
        assigned-clocks = <&camcc 85>;
        assigned-clock-rates = <19200000>;
        pinctrl-names = "default";
        pinctrl-0 = <&front_mclk>;
        reset-gpios = <&tlmm 30 1>;
        dovdd-supply = <&vreg_l1c_1p8>;
        avdd-supply = <&camera_front_analog>;
        dvdd-supply = <&camera_digital>;
        rotation = <180>;
        orientation = <0>;
        port { front_out: endpoint {
            data-lanes = <1 2>;
            link-frequencies = /bits/ 64 <720000000 360000000>;
            remote-endpoint = <&front_in>;
        }; };
    };
};
&camss {
    status = "okay";
    ports {
        port@1 { reg = <1>; front_in: endpoint {
            data-lanes = <0 1>;
            remote-endpoint = <&front_out>;
        }; };
    };
};
/ {
    camera_rear_analog: camera-rear-analog-regulator {
        compatible = "regulator-fixed";
        regulator-name = "camera-rear-analog";
        gpio = <&tlmm 11 0>;
        enable-active-high;
        startup-delay-us = <1000>;
        vin-supply = <&vreg_bob>;
    };
};
&tlmm {
    rear_mclk: rear-mclk-state {
        pins = "gpio13";
        function = "cam_mclk";
        drive-strength = <2>;
        bias-disable;
    };
};
&cci0_i2c0 {
    clock-frequency = <400000>;
    rear_camera: camera@10 {
        compatible = "ovti,ov13b10";
        reg = <0x10>;
        clocks = <&camcc 83>;
        clock-frequency = <19200000>;
        assigned-clocks = <&camcc 83>;
        assigned-clock-rates = <19200000>;
        pinctrl-names = "default";
        pinctrl-0 = <&rear_mclk>;
        reset-gpios = <&tlmm 28 1>;
        dovdd-supply = <&vreg_l1c_1p8>;
        avdd-supply = <&camera_rear_analog>;
        dvdd-supply = <&camera_digital>;
        rotation = <0>;
        orientation = <1>;
        port { rear_out: endpoint {
            data-lanes = <1 2 3 4>;
            link-frequencies = /bits/ 64 <560000000>;
            remote-endpoint = <&rear_in>;
        }; };
    };
};
&camss {
    ports {
        port@0 { reg = <0>; rear_in: endpoint {
            data-lanes = <0 1 2 3>;
            remote-endpoint = <&rear_out>;
        }; };
    };
};
/ {
    rear_vaf: rear-autofocus-regulator {
        compatible = "regulator-fixed";
        regulator-name = "rear-autofocus-2p8";
        regulator-min-microvolt = <2800000>;
        regulator-max-microvolt = <2800000>;
        gpio = <&tlmm 29 0>;
        enable-active-high;
        startup-delay-us = <1000>;
        vin-supply = <&vreg_bob>;
    };
};
&cci0_i2c0 {
    rear_lens: lens@c {
        compatible = "chipnext,cn3927";
        reg = <0x0c>;
        vdd-supply = <&rear_vaf>;
        vddio-supply = <&vreg_l1c_1p8>;
    };
};
&rear_camera {
    lens-focus = <&rear_lens>;
};

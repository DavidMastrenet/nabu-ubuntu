[Unit]
Description=Xiaomi Pad 5 Hall sensor to Linux lid switch
After=systemd-udev-trigger.service
Before=display-manager.service

[Service]
Type=simple
ExecStartPre=/sbin/modprobe uinput
ExecStart=/usr/bin/python3 /usr/local/sbin/nabu-lid-switch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

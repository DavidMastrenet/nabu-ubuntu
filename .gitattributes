# Keep everything that runs on the tablet in LF form: a CRLF shell script or
# udev rule does not work on Linux.
* text=auto
*.sh            text eol=lf
*.service       text eol=lf
*.rules         text eol=lf
*.conf          text eol=lf
*.md            text eol=lf
rootfs/usr/local/sbin/*   text eol=lf
boot/EFI/BOOT/refind.conf text eol=lf

# Binary payloads must never be normalised.
*.efi   binary
*.ko    binary
*.dtb   binary
*.so*   binary
*.pn    binary
